# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or any Postgres
# host all work). Get one free at https://neon.tech — create a project, copy the
# "Connection string" it gives you. Looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# Required for real AI scoring (explainability narrative) and the coding
# station's AI helper chat. Without it, reports fall back to a clearly-labeled
# rule-based narrative and the code helper says it's unavailable — nothing
# crashes either way.
ANTHROPIC_API_KEY=

# Required to actually send the candidate results email on completion. Get a
# free key at https://resend.com. Without it, results still compute and show
# on the dashboard, the email is just skipped (logged server-side instead).
RESEND_API_KEY=

# Any long random string. Used to sign the employer session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"
